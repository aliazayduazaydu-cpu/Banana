local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local lp = Players.LocalPlayer

local DELAY = 0 -- الوقت بين كل دورة في الاوتو
local auto = false

-- الأجزاء
local targets = {
    function() return workspace:FindFirstChild("Gudock") end,
}
for i = 1, 7 do
    table.insert(targets, function()
        local t = workspace:FindFirstChild("TrollPart1")
        return t and t:GetChildren()[i]
    end)
end

local function touch(obj)
    local char = lp.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not (obj and hrp) then return end
    local parts = {}
    if obj:IsA("BasePart") then
        parts = {obj}
    else
        for _, d in ipairs(obj:GetDescendants()) do
            if d:IsA("BasePart") then table.insert(parts, d) end
        end
    end
    for _, p in ipairs(parts) do
        firetouchinterest(hrp, p, 0)
        task.wait()
        firetouchinterest(hrp, p, 1)
    end
end

local function touchAll()
    for _, getter in ipairs(targets) do
        touch(getter())
    end
end

