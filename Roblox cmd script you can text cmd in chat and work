--==================================================

CommandBox.FocusLost:Connect(function(
    EnterPressed
)

    if not EnterPressed then
        return
    end

    local Text =
        CommandBox.Text

    if Text ~= "" then

        ExecuteCommand(Text)

        CommandBox.Text = ""
    end
end)

