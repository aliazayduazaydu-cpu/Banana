local function UpdateESP()

    if not ESPEnabled then
        return
    end

    local Camera =
        workspace.CurrentCamera

    if not Camera then
        return
    end

    local MyCharacter =
        Player.Character

    local MyRoot =
        MyCharacter and
        MyCharacter:FindFirstChild(
            "HumanoidRootPart"
        )

    if not MyRoot then
        return
    end

    local MyScreen =
        Camera:WorldToViewportPoint(
            MyRoot.Position
        )

    for TargetPlayer,Objects in pairs(ESPObjects) do

        local Character =
            TargetPlayer.Character

        local Root =
            Character and
            Character:FindFirstChild(
                "HumanoidRootPart"
            )

        local Head =
            Character and
            Character:FindFirstChild("Head")

        local Humanoid =
            Character and
            Character:FindFirstChildOfClass(
                "Humanoid"
            )

        if Root
        and Head
        and Humanoid
        and Humanoid.Health > 0 then

            local Top =
                Camera:WorldToViewportPoint(
                    Head.Position +
                    Vector3.new(0,0.6,0)
                )

            local Bottom =
                Camera:WorldToViewportPoint(
                    Root.Position -
                    Vector3.new(0,3,0)
                )

            local Center =
                Camera:WorldToViewportPoint(
                    Root.Position
                )

            if Top.Z > 0
            and Bottom.Z > 0 then

                local Height =
                    math.abs(
                        Bottom.Y - Top.Y
                    )

                local Width =
                    Height * 0.55

                local X =
                    Center.X - Width / 2

                local Y = Top.Y

                -- مربع
                Objects.Box.Position =
                    UDim2.fromOffset(X,Y)

                Objects.Box.Size =
                    UDim2.fromOffset(
                        Width,
                        Height
                    )

                Objects.Box.Visible = true

                -- الاسم
                Objects.Name.Position =
                    UDim2.fromOffset(
                        Center.X - Width,
                        Y - 20
                    )

                Objects.Name.Size =
                    UDim2.fromOffset(
                        Width * 2,
                        18
                    )

                Objects.Name.Text =
                    TargetPlayer.Name

                Objects.Name.Visible = true

                -- الخط
                local TargetPoint =
                    Vector2.new(
                        Center.X,
                        Bottom.Y
                    )

                local MyPoint =
                    Vector2.new(
                        MyScreen.X,
                        MyScreen.Y
                    )

                local Difference =
                    TargetPoint - MyPoint

                local Distance =
                    Difference.Magnitude

                local Middle =
                    (TargetPoint + MyPoint) / 2

                Objects.Line.Position =
                    UDim2.fromOffset(
                        Middle.X,
                        Middle.Y
                    )

                Objects.Line.Size =
                    UDim2.fromOffset(
                        Distance,
                        1
                    )

                Objects.Line.Rotation =
                    math.deg(
                        math.atan2(
                            Difference.Y,
                            Difference.X
                        )
                    )

                Objects.Line.Visible = true

            else

                Objects.Box.Visible = false
                Objects.Line.Visible = false
                Objects.Name.Visible = false
            end

        else

            Objects.Box.Visible = false
            Objects.Line.Visible = false
            Objects.Name.Visible = false
        end
    end
end

local function StartESP()

    if ESPEnabled then
        return
    end

    ESPEnabled = true

    for _,TargetPlayer in
        ipairs(Players:GetPlayers()) do

        if TargetPlayer ~= Player then
            CreateESP(TargetPlayer)
        end
    end

    ESPConnection =
        RunService.RenderStepped:Connect(
            UpdateESP
        )
end

Players.PlayerAdded:Connect(function(TargetPlayer)

    if ESPEnabled then
        CreateESP(TargetPlayer)
    end
end)

Players.PlayerRemoving:Connect(function(TargetPlayer)

    local Objects =
        ESPObjects[TargetPlayer]

    if Objects then

        for _,Object in pairs(Objects) do

            if Object then
                Object:Destroy()
            end
        end

        ESPObjects[TargetPlayer] = nil
    end
end)--==================================================
