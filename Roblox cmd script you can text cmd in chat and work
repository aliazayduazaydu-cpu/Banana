local function initialRise(Character)

    local RiseSpeed = 10
    local StartTime = tick()
    local RiseTime = 0.1

    while tick() - StartTime < RiseTime do

        if not BodyVelocity then
            break
        end

        BodyVelocity.Velocity =
            Vector3.new(0, RiseSpeed, 0)

        RunService.RenderStepped:Wait()
    end
end

local function startFlying()

    if Flying then
        return
    end

    local Character =
        Player.Character or Player.CharacterAdded:Wait()

    local Humanoid =
        Character:WaitForChild("Humanoid")

    local Root =
        Character:WaitForChild("HumanoidRootPart")

    Flying = true
    Humanoid.PlatformStand = true

    BodyVelocity = Instance.new("BodyVelocity")
    BodyVelocity.MaxForce =
        Vector3.new(100000,100000,100000)
    BodyVelocity.Velocity =
        Vector3.new(0,0,0)
    BodyVelocity.Parent = Root

    BodyGyro = Instance.new("BodyGyro")
    BodyGyro.MaxTorque =
        Vector3.new(100000,100000,100000)
    BodyGyro.CFrame = Root.CFrame
    BodyGyro.Parent = Root

    initialRise(Character)

    FlyConnection =
        RunService.RenderStepped:Connect(function()

        if not Flying
        or not Character.Parent
        or not BodyVelocity
        or not BodyGyro then
            return
        end

        local Camera =
            workspace.CurrentCamera

        if not Camera then
            return
        end

        local MoveDirection =
            Humanoid.MoveDirection * FlySpeed

        local CameraLookVector =
            Camera.CFrame.LookVector

        if MoveDirection.Magnitude > 0 then

            if CameraLookVector.Y > 0.2
            or CameraLookVector.Y < -0.2 then

                MoveDirection =
                    MoveDirection +
                    Vector3.new(
                        0,
                                               CameraLookVector.Y * FlySpeed,
                        0
                    )
            end

        else

            MoveDirection =
                BodyVelocity.Velocity:Lerp(
                    Vector3.new(0,0,0),
                    0.085
                )
        end

        BodyVelocity.Velocity =
            MoveDirection

        local TiltAngle = 40
        local TiltFactor = 0

        if FlySpeed ~= 0 then
            TiltFactor =
                MoveDirection.Magnitude / FlySpeed
        end

        local TiltDirection = 1

        if Camera.CFrame:VectorToObjectSpace(
            MoveDirection
        ).Z < 0 then

            TiltDirection = -1
        end

        local TiltCFrame =
            CFrame.Angles(
                math.rad(TiltAngle)
                * TiltFactor
                * TiltDirection,
                0,
                0
            )

        local TargetCFrame =
            CFrame.new(
                Root.Position,
                Root.Position + CameraLookVector
            ) * TiltCFrame

        BodyGyro.CFrame =
            BodyGyro.CFrame:Lerp(
                TargetCFrame,
                0.2
            )
    end)
end

local function stopFlying()

    if not Flying then
        return
    end

    Flying = false

    local Character = Player.Character

    if Character then

        local Humanoid =
            Character:FindFirstChildOfClass("Humanoid")

        if Humanoid then
            Humanoid.PlatformStand = false
        end
    end

    if FlyConnection then
        FlyConnection:Disconnect()
        FlyConnection = nil
    end

    if BodyVelocity then
        BodyVelocity:Destroy()
        BodyVelocity = nil
    end

    if BodyGyro then
        BodyGyro:Destroy()
        BodyGyro = nil
    end
end

