-- دالة صنع زر دائري بصورة
local function makeButton(name, image, xPos, callback)
	local btn = Instance.new("ImageButton")
	btn.Name = name
	btn.Size = UDim2.new(0.26, 0, 0.26, 0)
	btn.Position = UDim2.new(xPos, 0, 0.42, 0)
	btn.BackgroundTransparency = 1
	btn.Image = "rbxassetid://" .. image
	btn.ScaleType = Enum.ScaleType.Fit
	btn.Parent = menu

	local r = Instance.new("UIAspectRatioConstraint")
	r.Parent = btn
	Instance.new("UICorner", btn).CornerRadius = UDim.new(1, 0) -- دائري

	local s = Instance.new("UIScale")
	s.Parent = btn

	btn.MouseEnter:Connect(function()
		tween(s, 0.15, {Scale = 1.1})
	end)
	btn.MouseLeave:Connect(function()
		tween(s, 0.15, {Scale = 1})
	end)

	btn.MouseButton1Click:Connect(function()
		-- قفزة صغيرة
		tween(s, 0.1, {Scale = 0.85}).Completed:Wait()
		tween(s, 0.25, {Scale = 1.1}, Enum.EasingStyle.Back)
		callback()
	end)
	return btn
end

