------------------------------------------------ المدخلات (ماوس + لمس + كيبورد)
joyBase.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.Touch and not moveTouch then
		moveTouch = input
	end
end)

UIS.InputBegan:Connect(function(input, gp)
	if gp then return end
	-- F : تشغيل / إيقاف الفري كام
	if input.KeyCode == Enum.KeyCode.F then
		if mode == "free" then stopAll() else startFree() end
		return
	end
	if mode == "view" then
		if input.KeyCode == Enum.KeyCode.Left then cycle(-1)
		elseif input.KeyCode == Enum.KeyCode.Right then cycle(1) end
		return
	end
	if mode ~= "free" then return end
	if input.UserInputType == Enum.UserInputType.MouseButton2 then
		rotating = true
		UIS.MouseBehavior = Enum.MouseBehavior.LockCurrentPosition
	elseif input.UserInputType == Enum.UserInputType.Touch and not lookTouch and input ~= moveTouch then
		lookTouch = input
	end
end)

UIS.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton2 then
		rotating = false
		if mode == "free" then UIS.MouseBehavior = Enum.MouseBehavior.Default end
	elseif input == lookTouch then
		lookTouch = nil
	elseif input == moveTouch then
		resetStick()
	end
end)

UIS.InputChanged:Connect(function(input, gp)
	if mode ~= "free" then return end
	if input.UserInputType == Enum.UserInputType.MouseMovement and rotating then
		tYaw = tYaw - input.Delta.X * 0.0035 * S.sens
		tPitch = math.clamp(tPitch - input.Delta.Y * 0.0035 * S.sens, -1.5, 1.5)
	elseif input.UserInputType == Enum.UserInputType.MouseWheel and not gp then
		setSpeed(speed * (1 + 0.15 * input.Position.Z))
	elseif input == lookTouch then
		tYaw = tYaw - input.Delta.X * 0.006 * S.sens
		tPitch = math.clamp(tPitch - input.Delta.Y * 0.006 * S.sens, -1.5, 1.5)
	elseif input == moveTouch then
		local center = joyBase.AbsolutePosition + joyBase.AbsoluteSize / 2
		local off = (Vector2.new(input.Position.X, input.Position.Y) - center) / (joyBase.AbsoluteSize.X / 2)
		if off.Magnitude > 1 then off = off.Unit end
		stickVec = off
		knob.Position = UDim2.new(0.5, off.X * 35 - 25, 0.5, off.Y * 35 - 25)
	end
end)
