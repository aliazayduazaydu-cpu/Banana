local function newPanel(titleText, size)
	local f = Instance.new("Frame")
	f.AnchorPoint = Vector2.new(0.5, 0.5)
	f.Position = UDim2.new(0.5, 0, 0.5, 0)
	f.Size = UDim2.new()
	f.BackgroundColor3 = Color3.fromRGB(20, 20, 30)
	f.BackgroundTransparency = 0.05
	f.ClipsDescendants = true
	f.Visible = false
	f:SetAttribute("full", size)
	corner(f, 12)
	local t = newLabel(f, titleText, UDim2.new(1, 0, 0, 34))
	t.TextSize = 18
	t.BackgroundColor3 = Color3.new(0, 0, 0)
	t.BackgroundTransparency = 0.5
	makeDraggable(f, t)
	return f, t
end

local function showPanel(f)
	f.Size = UDim2.new()
	f.Visible = true
	TweenService:Create(f, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size = f:GetAttribute("full")}):Play()
end

local function hidePanel(f)
	if not f.Visible then return end
	local t = TweenService:Create(f, TweenInfo.new(0.18), {Size = UDim2.new()})
	t:Play()
	t.Completed:Once(function()
		if f.Size.X.Offset == 0 then f.Visible = false end
	end)
end

local function setControls(enabled)
	pcall(function()
		local module = player.PlayerScripts:FindFirstChild("PlayerModule")
		if not module then return end
		local controls = require(module):GetControls()
		if enabled then controls:Enable() else controls:Disable() end
	end)
end

local function setFreeze(on)
	local ch = player.Character
	local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
	if not hrp then return end
	if on and mode == "free" then
		if not hrp.Anchored then
			hrp.Anchored = true
			anchoredByUs = true
		end
	elseif anchoredByUs then
		hrp.Anchored = false
		anchoredByUs = false
	end
end

