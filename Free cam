------------------------------------------------ التحكم
local function resetStick()
	moveTouch = nil
	stickVec = Vector2.zero
	knob.Position = UDim2.new(0.5, -25, 0.5, -25)
end

local function unbindLoop()
	if bound then
		RunService:UnbindFromRenderStep(LOOP)
		bound = false
	end
end

local function bindLoop(fn)
	unbindLoop()
	RunService:BindToRenderStep(LOOP, Enum.RenderPriority.Camera.Value + 1, fn)
	bound = true
end

local function applyUiHidden(h)
	uiHidden = h
	toggleBtn.Visible = not h
	showBtn.Visible = h
	hud.Visible = (not h) and mode ~= nil
	local touchUi = (not h) and mode == "free" and UIS.TouchEnabled
	touchCtl.Visible = touchUi
	joyBase.Visible = touchUi
	if h then
		hidePanel(mainPanel)
		hidePanel(listPanel)
		hidePanel(settingsPanel)
	end
end

local function stopAll()
	unbindLoop()
	local was = mode
	setFreeze(false)
	mode = nil
	targetPlayer = nil
	rotating = false
	lookTouch = nil
	vertTouch = 0
	resetStick()
	UIS.MouseBehavior = Enum.MouseBehavior.Default
	applyUiHidden(false)
	if was then
		setControls(true)
		cam.CameraType = Enum.CameraType.Custom
		local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		if hum then cam.CameraSubject = hum end
		if origFov then cam.FieldOfView = origFov end
	end
	origFov = nil
end

local function startFree()
	stopAll()
	mode = "free"
	origFov = cam.FieldOfView
	local pitch, yaw = cam.CFrame:ToOrientation()
	camPos = cam.CFrame.Position
	tYaw, tPitch, sYaw, sPitch, sRoll = yaw, pitch, yaw, pitch, 0
	tFov, sFov = cam.FieldOfView, cam.FieldOfView
	if fovSet then fovSet(tFov, true) end
	velocity = Vector3.zero
	cam.CameraType = Enum.CameraType.Scriptable
	setControls(false)
	setFreeze(S.freeze)
	setHud("free", "Free Cam")
	applyUiHidden(false)

	bindLoop(function(dt)
		local rotRate = 40 / (S.smooth + 1)
		local moveRate = 24 / (S.smooth + 1)
		local a = math.min(1, dt * rotRate)
		sYaw = sYaw + (tYaw - sYaw) * a
		sPitch = sPitch + (tPitch - sPitch) * a
		local rot = CFrame.fromOrientation(sPitch, sYaw, 0)

		local mx, mz, my = stickVec.X, stickVec.Y, vertTouch
		local boost = 1
		if not UIS:GetFocusedTextBox() then
			if UIS:IsKeyDown(Enum.KeyCode.W) then mz -= 1 end
			if UIS:IsKeyDown(Enum.KeyCode.S) then mz += 1 end
			if UIS:IsKeyDown(Enum.KeyCode.A) then mx -= 1 end
			if UIS:IsKeyDown(Enum.KeyCode.D) then mx += 1 end
			if UIS:IsKeyDown(Enum.KeyCode.E) or UIS:IsKeyDown(Enum.KeyCode.Space) then my += 1 end
			if UIS:IsKeyDown(Enum.KeyCode.Q) then my -= 1 end
			if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then boost = 3 end
			if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then boost = 0.3 end
			-- زوم بالمفاتيح
			local z = 0
			if UIS:IsKeyDown(Enum.KeyCode.Z) then z -= 1 end
			if UIS:IsKeyDown(Enum.KeyCode.X) then z += 1 end
			if z ~= 0 then
				tFov = math.clamp(tFov + z * 45 * dt, 15, 120)
				if fovSet then fovSet(tFov, true) end
			end
		end
		sFov = sFov + (tFov - sFov) * math.min(1, dt * 8)
		cam.FieldOfView = sFov

		local dir = rot:VectorToWorldSpace(Vector3.new(mx, 0, mz)) + Vector3.new(0, my, 0)
		if dir.Magnitude > 1 then dir = dir.Unit end
		velocity = velocity:Lerp(dir * speed * boost, math.min(1, dt * moveRate))
		camPos = camPos + velocity * dt

		local roll = 0
		if S.tilt then
			local lv = rot:VectorToObjectSpace(velocity)
			roll = -math.clamp(lv.X / math.max(speed, 1), -1.5, 1.5) * 0.05
		end
		sRoll = sRoll + (roll - sRoll) * math.min(1, dt * 6)

		cam.CFrame = CFrame.new(camPos) * rot * CFrame.Angles(0, 0, sRoll)
	end)
end

local function startView(p)
	stopAll()
	mode = "view"
	targetPlayer = p
	cam.CameraType = Enum.CameraType.Custom
	setHud("view", p.DisplayName)
	bindLoop(function()
		if not targetPlayer or not targetPlayer.Parent then
			stopAll()
			return
		end
		local ch = targetPlayer.Character
		local hum = ch and ch:FindFirstChildOfClass("Humanoid")
		if hum and cam.CameraSubject ~= hum then cam.CameraSubject = hum end
		if cam.CameraType ~= Enum.CameraType.Custom then cam.CameraType = Enum.CameraType.Custom end
	end)
end

local function cycle(dir)
	local others = {}
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player then table.insert(others, p) end
	end
	if #others == 0 then return end
	local idx = table.find(others, targetPlayer) or 0
	idx = (idx - 1 + dir) % #others + 1
	startView(others[idx])
end

