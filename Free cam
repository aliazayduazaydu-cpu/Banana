------------------------------------------------ أدوات مساعدة
local function corner(obj, r)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, r or 8)
	c.Parent = obj
end

local function isPress(i)
	return i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch
end

-- سحب (يرجع دالة تقول هل تم السحب فعلا أو كان ضغطة فقط)
local function makeDraggable(target, handle)
	handle = handle or target
	local dragInput, startPos, startMouse, moved = nil, nil, nil, false
	handle.InputBegan:Connect(function(input)
		if isPress(input) then
			dragInput = (input.UserInputType == Enum.UserInputType.Touch) and input or "mouse"
			startMouse = input.Position
			startPos = target.Position
			moved = false
		end
	end)
	UIS.InputChanged:Connect(function(input)
		if not dragInput then return end
		if (dragInput == "mouse" and input.UserInputType == Enum.UserInputType.MouseMovement) or input == dragInput then
			local d = input.Position - startMouse
			if d.Magnitude > 8 then moved = true end
			if moved then
				target.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
			end
		end
	end)
	UIS.InputEnded:Connect(function(input)
		if (dragInput == "mouse" and input.UserInputType == Enum.UserInputType.MouseButton1) or input == dragInput then
			dragInput = nil
		end
	end)
	return function() return moved end
end

local function newButton(parent, text, size, pos)
	local b = Instance.new("TextButton")
	b.Size = size or UDim2.new(1, -6, 0, 38)
	if pos then b.Position = pos end
	b.BackgroundColor3 = Color3.fromRGB(40, 40, 60)
	b.BackgroundTransparency = 0.1
	b.Text = text
	b.TextColor3 = Color3.new(1, 1, 1)
	b.Font = Enum.Font.GothamBold
	b.TextSize = 15
	b.Parent = parent
	corner(b)
	return b
end

local function newLabel(parent, text, size, pos)
	local l = Instance.new("TextLabel")
	l.Size = size
	l.Position = pos or UDim2.new()
	l.BackgroundTransparency = 1
	l.Text = text
	l.TextColor3 = Color3.new(1, 1, 1)
	l.Font = Enum.Font.GothamBold
