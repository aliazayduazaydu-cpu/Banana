local function loadThumb(img, userId)
	if thumbCache[userId] then
		img.Image = thumbCache[userId]
		return
	end
	task.spawn(function()
		local ok, content = pcall(Players.GetUserThumbnailAsync, Players, userId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size48x48)
		if ok then
			thumbCache[userId] = content
			if img.Parent then img.Image = content end
		end
	end)
end

