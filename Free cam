local function makeSlider(text, min, max, init, y, fmt, onChange)
	local holder = Instance.new("Frame")
	holder.Size = UDim2.new(1, -24, 0, 44)
	holder.Position = UDim2.new(0, 12, 0, y)
	holder.BackgroundTransparency = 1
	holder.Parent = settingsPanel
	local lab = newLabel(holder, "", UDim2.new(1, 0, 0, 20))
	lab.TextSize = 14
	local bar = Instance.new("Frame")
	bar.Size = UDim2.new(1, 0, 0, 8)
	bar.Position = UDim2.new(0, 0, 0, 30)
	bar.BackgroundColor3 = Color3.fromRGB(60, 60, 85)
	bar.Active = true
	bar.Parent = holder
	corner(bar, 4)
	local fill = Instance.new("Frame")
	fill.BackgroundColor3 = ACCENT
	fill.Parent = bar
	corner(fill, 4)
	local knobS = Instance.new("Frame")
	knobS.Size = UDim2.new(0, 18, 0, 18)
	knobS.BackgroundColor3 = Color3.new(1, 1, 1)
	knobS.Parent = bar
	corner(knobS, 9)

	local function set(v, silent)
		v = math.clamp(v, min, max)
		local a = (v - min) / (max - min)
		fill.Size = UDim2.new(a, 0, 1, 0)
		knobS.Position = UDim2.new(a, -9, 0.5, -9)
		lab.Text = text .. " : " .. fmt(v)
		if not silent then onChange(v) end
	end

	local dragInput
	local function fromX(x)
		set(min + (max - min) * math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1))
	end
	bar.InputBegan:Connect(function(i)
		if isPress(i) then
			dragInput = (i.UserInputType == Enum.UserInputType.Touch) and i or "mouse"
			fromX(i.Position.X)
		end
	end)
	UIS.InputChanged:Connect(function(i)
		if dragInput and ((dragInput == "mouse" and i.UserInputType == Enum.UserInputType.MouseMovement) or i == dragInput) then
			fromX(i.Position.X)
		end
	end)
	UIS.InputEnded:Connect(function(i)
		if (dragInput == "mouse" and i.UserInputType == Enum.UserInputType.MouseButton1) or i == dragInput then
			dragInput = nil
		end
	end)
	set(init, true)
	return set
end

