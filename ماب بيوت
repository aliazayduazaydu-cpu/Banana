------------------------------------------------ 3) الانتقال
local index = 0
local flyMode = false
local flySpeed = 100
local currentTween, noclipConn

local function stopFly()
	if currentTween then currentTween:Cancel() currentTween = nil end
	if noclipConn then noclipConn:Disconnect() noclipConn = nil end
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if hrp then hrp.Anchored = false end
end

local function goTo(p)
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end
	stopFly()
	local target = CFrame.new(p[1], p[2] + 3, p[3])
	if not flyMode then
		hrp.CFrame = target
		return
	end
	local dist = (hrp.Position - target.Position).Magnitude
	hrp.Anchored = true
	noclipConn = RunService.Stepped:Connect(function()
		for _, part in ipairs(char:GetDescendants()) do
			if part:IsA("BasePart") then part.CanCollide = false end
		end
	end)
	currentTween = TweenService:Create(hrp, TweenInfo.new(dist / math.max(flySpeed, 1), Enum.EasingStyle.Linear), {CFrame = target})
	local tw = currentTween
	tw.Completed:Connect(function()
		if currentTween == tw then stopFly() end
	end)
	tw:Play()
end

