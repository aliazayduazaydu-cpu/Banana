local function makeToggle(text, callback)
	local b = makeButton(text .. " : OFF")
	local on = false
	b.BackgroundColor3 = Color3.fromRGB(120, 40, 40)
	b.MouseButton1Click:Connect(function()
		on = not on
		b.Text = text .. (on and " : ON" or " : OFF")
		b.BackgroundColor3 = on and Color3.fromRGB(40, 130, 60) or Color3.fromRGB(120, 40, 40)
		callback(on)
	end)
end

